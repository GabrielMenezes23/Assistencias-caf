# Projeto Supabase informado para esta aplicação.
NEXT_PUBLIC_SUPABASE_URL=https://eomfqwpzrgvaabrszryc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# Somente para scripts administrativos locais. Nunca use em NEXT_PUBLIC_* ou na Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Geocodificação: auto usa Google quando configurado, senão Nominatim + cache, e por fim município.
GEOCODER_PROVIDER=auto
NOMINATIM_USER_AGENT=CAF-Assistencias/0.5 (contato: ti@cafmaquinas.com.br)
NOMINATIM_EMAIL=

# Google Maps é opcional. Quando configurado, fornece autocomplete e mapa Google.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_SERVER_API_KEY=

# OpenStreetMap/Leaflet é o mapa padrão sem chave. Pode ser desativado em ambientes restritos.
NEXT_PUBLIC_OSM_MAP_ENABLED=true

# Pré-visualização local sem Supabase. Não habilitar em produção.
NEXT_PUBLIC_DEMO_MODE=false
